{
  "name": "subnetcalc-electron",
  "version": "1.0.0",
  "description": "High-precision IPv4 & IPv6 Subnet Calculator Desktop Application with FLSM, VLSM, CIDR Summarization, and RFC Compliance",
  "keywords": [
    "subnet",
    "subnet-calculator",
    "ipv4",
    "ipv6",
    "cidr",
    "flsm",
    "vlsm",
    "networking",
    "electron",
    "react",
    "typescript"
  ],
  "author": {
    "name": "Harry Dertin Sutisna Alsyundawy",
    "email": "alsyundawy@gmail.com",
    "url": "https://github.com/alsyundawy"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alsyundawy/SubNetCalc-Electron.git"
  },
  "bugs": {
    "url": "https://github.com/alsyundawy/SubNetCalc-Electron/issues"
  },
  "homepage": "https://github.com/alsyundawy/SubNetCalc-Electron#readme",
  "license": "MIT",
  "main": "dist-electron/main/index.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron .",
    "build:engine": "tsc -p tsconfig.engine.json",
    "build:main": "vite build --config vite.config.main.ts",
    "build:preload": "vite build --config vite.config.preload.ts",
    "build:renderer": "vite build",
    "build": "npm run build:engine && npm run build:main && npm run build:preload && npm run build:renderer",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.engine.json --noEmit",
    "lint": "oxlint src/ test/",
    "lint:fix": "oxlint --fix src/ test/",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "maxmind": "^5.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}

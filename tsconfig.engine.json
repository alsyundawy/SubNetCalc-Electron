{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "declaration": true,
    "rootDir": "./src/engine",
    "outDir": "dist-electron/engine",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@engine/*": ["./src/engine/*"]
    }
  },
  "include": ["src/engine/**/*"]
}
